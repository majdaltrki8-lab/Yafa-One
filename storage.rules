rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'majdaltrki8@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function hasIncomingOwner() {
      return isSignedIn()
        && request.resource != null
        && request.resource.metadata != null
        && request.resource.metadata.ownerId == request.auth.uid;
    }

    function isExistingOwner() {
      return isSignedIn()
        && resource != null
        && resource.metadata != null
        && resource.metadata.ownerId == request.auth.uid;
    }

    // Store logos, covers, gallery (strictly scoped to uploader ownerId or verified admin)
    match /establishments/{establishmentId}/{allPaths=**} {
      allow read: if true;
      allow create: if isValidImageUpload() && (hasIncomingOwner() || isVerifiedAdmin());
      allow update: if isValidImageUpload() && ((isExistingOwner() && hasIncomingOwner()) || isVerifiedAdmin());
      allow delete: if isExistingOwner() || isVerifiedAdmin();
    }

    // Product images (strictly scoped to uploader ownerId or verified admin)
    match /products/{allPaths=**} {
      allow read: if true;
      allow create: if isValidImageUpload() && (hasIncomingOwner() || isVerifiedAdmin());
      allow update: if isValidImageUpload() && ((isExistingOwner() && hasIncomingOwner()) || isVerifiedAdmin());
      allow delete: if isExistingOwner() || isVerifiedAdmin();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    // Professional registration avatar (allows pending PRO-* registration create, owner/admin updates & deletes)
    match /professionals/{profId}/{allPaths=**} {
      allow read: if true;
      allow create: if profId.matches('^PRO-[0-9]+$') && isValidImageUpload();
      allow update: if isValidImageUpload() && ((isExistingOwner() && hasIncomingOwner()) || isVerifiedAdmin());
      allow delete: if isExistingOwner() || isVerifiedAdmin();
    }

    match /advertisements/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    match /brand/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    match /remittance/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }

    // Used marketplace images (strictly scoped to seller ownerId or verified admin)
    match /used/{fileName} {
      allow read: if true;
      allow create: if isValidImageUpload() && (hasIncomingOwner() || isVerifiedAdmin());
      allow update: if isValidImageUpload() && ((isExistingOwner() && hasIncomingOwner()) || isVerifiedAdmin());
      allow delete: if isExistingOwner() || isVerifiedAdmin();
    }

    match /app-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isVerifiedAdmin() && isValidImageUpload();
      allow delete: if isVerifiedAdmin();
    }
  }
}
