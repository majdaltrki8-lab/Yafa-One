rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public read for platform media, store images, and product photos
    match /establishments/{establishmentId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /advertisements/{adId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'majdaltrki8@gmail.com'
      );
    }

    match /brand/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'majdaltrki8@gmail.com'
      );
    }
  }
}
